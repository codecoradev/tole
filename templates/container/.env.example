# Copy to .env (compose reads it for interpolation). Nothing secret goes here:
# the serve token and the provider key are files under ./secrets.

# Public name of the VPS; Caddy gets a Let's Encrypt certificate for it. Leave
# `localhost` to try the stack on one machine (Caddy's own local CA signs it).
TOLE_DOMAIN=localhost

# Provider endpoint and model. tole has no built-in provider default: blank means
# unset, and the provider then has to come from the user config under
# /data/codecora/tole/config.toml (the tole-data volume). The key is the
# secrets/tole_api_key file. If you set one of base URL, model and key through
# the environment, set all three.
TOLE_BASE_URL=
TOLE_MODEL=

# Host ports of the proxy (change both only when 80/443 are taken).
TOLE_HTTP_PORT=80
TOLE_HTTPS_PORT=443

# Which image the `tole` service runs.
#   Build it here from the Dockerfile (the default):
#     TOLE_IMAGE=tole-serve          TOLE_IMAGE_TAG=local
#   Run a published image (docs/container.md, "Channels and tags"):
#     TOLE_IMAGE=ghcr.io/codecoradev/tole
#     TOLE_IMAGE_TAG=0.12.0     an exact release: recommended for a VPS
#     TOLE_IMAGE_TAG=stable     the newest release: follows the production channel
#     TOLE_IMAGE_TAG=nightly    the head of develop: for trying what is next
#   There is no `latest`. After changing these: docker compose pull tole && docker compose up -d --no-build
TOLE_IMAGE=tole-serve
TOLE_IMAGE_TAG=local
