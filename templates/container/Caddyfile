# TLS reverse proxy for `tole serve` (issue #1044, docs/container.md).
#
# Caddy gets and renews the certificate itself (Let's Encrypt for a public
# name; for `localhost` its own local CA). The settings that matter for the
# live event stream (GET /sessions/{id}/events, Server-Sent Events):
#   - flush_interval -1: every write from tole is forwarded at once, nothing is
#     batched into a buffer.
#   - no `encode` block: do not compress text/event-stream (a compressor holds
#     data back until its buffer fills).
#   - request_buffers: see the comment below (tole refuses chunked request bodies).
#   - flush_interval -1 is belt and braces: in a test Caddy 2.11.9 also streamed a
#     text/event-stream response unbatched without it. Keep it.
#   - no timeouts on the upstream: serve sends a `: ping` comment every 15 s
#     (TOLE_SERVE_HEARTBEAT_SECS), and POST /sessions/{id}/prompt answers only
#     when the whole turn is over (minutes), so any read timeout would cut a
#     healthy request. Caddy sets none by default; do not add one.
{$TOLE_DOMAIN:localhost} {
	# The largest body tole accepts is an image upload of 10 MiB.
	request_body {
		max_size 12MB
	}

	header {
		X-Content-Type-Options "nosniff"
		-Server
	}

	# HSTS pins the NAME to https for a year and browsers ignore the port, so it
	# is not sent for localhost (it would pin your other local http servers).
	@public not host localhost
	header @public Strict-Transport-Security "max-age=31536000"

	reverse_proxy tole:7801 {
		flush_interval -1
		# tole accepts only request bodies with a Content-Length and answers 400 to
		# any Transfer-Encoding (serve.rs). Run against Caddy 2.11.9 with a mock
		# upstream: with request_buffers a body of unknown length that arrives over
		# HTTP/2 is forwarded with a Content-Length (without it, chunked), but a
		# chunked HTTP/1.1 request body is still forwarded chunked. `tole-client`
		# always sends a Content-Length, so it is not affected; a client that sends
		# chunked HTTP/1.1 bodies needs the nginx recipe (it always sets a length).
		request_buffers 12MB
		# tole speaks HTTP/1.1 and ends a streamed response by closing it.
		transport http {
			versions 1.1
		}
	}
}
