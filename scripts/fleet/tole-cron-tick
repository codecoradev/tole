#!/usr/bin/env bash
# Run one `tole cron tick` pass, logged, with a lock so a slow tick is never
# overlapped by the next scheduler call (the overlapping call exits 0, skipped).
# Same environment as tole-serve-launcher; sessions dir defaults to the daemon's.
# Note: agent jobs needing Writes are refused here; host them with `tole serve --cron`.
#
# Usage: tole-cron-tick [extra `tole cron tick` args]
# Linux only (flock). Needs flock(1); without it the wrapper fails loudly (exit 127)
# instead of skipping every tick.
# Exit codes: tick's exit code; 0 when skipped because another tick is running;
# 127 when flock is not installed.
set -euo pipefail
umask 077

TOLE_BIN="${TOLE_BIN:-tole}"
DIR="${TOLE_FLEET_DIR:-$HOME/.local/state/tole-fleet}"
SESSIONS="${TOLE_FLEET_SESSIONS:-$DIR/sessions}"
LOCK="$DIR/cron-tick.lock"
LOG_FILE="$DIR/cron-tick.log"
mkdir -p "$DIR" "$SESSIONS"
chmod 700 "$DIR"
cd "$DIR"  # script jobs run in the tick's cwd: keep it out of the caller's tree

say() { printf '%s tole-cron-tick: %s\n' "$(date -u +%FT%TZ)" "$*" >>"$LOG_FILE"; }

if ! command -v flock >/dev/null 2>&1; then
  say "flock not found, tick NOT run (install util-linux)"
  echo "tole-cron-tick: flock not found (install util-linux)" >&2
  exit 127
fi
exec 9>"$LOCK"
lrc=0
flock -n 9 || lrc=$?
if [[ $lrc -eq 1 ]]; then
  say "skipped, previous tick still running"
  exit 0
elif [[ $lrc -ne 0 ]]; then
  say "flock failed rc=$lrc, tick NOT run"
  exit "$lrc"
fi

say "tick start"
rc=0
# 9>&-: the tick's children (a script job that backgrounds something) must not inherit the lock.
"$TOLE_BIN" cron --sessions-dir "$SESSIONS" tick "$@" >>"$LOG_FILE" 2>&1 9>&- || rc=$?
say "tick done rc=$rc"
exit "$rc"
