#!/usr/bin/env bash
# Start / stop / inspect the 24/7 `tole serve` daemon on a host without systemd
# (see docs/fleet-daemon.md). Idempotent: `start` on a live daemon is a no-op.
#
# Usage: tole-serve-launcher [start|stop|status] [-- extra `tole serve` args]
#
# Environment (all optional):
#   TOLE_BIN             tole binary            (default: tole on PATH)
#   TOLE_FLEET_DIR       state dir: pid, log, token   (default: ~/.local/state/tole-fleet)
#   TOLE_FLEET_PORT      listen port            (default: 7801)
#   TOLE_FLEET_BIND      bind address           (default: 127.0.0.1)
#   TOLE_FLEET_SESSIONS  sessions dir           (default: $TOLE_FLEET_DIR/sessions)
#   TOLE_FLEET_TOKEN_FILE bearer token file     (default: $TOLE_FLEET_DIR/token, created 0600 if absent)
#
# Linux only (/proc, flock, setsid). start and stop serialise on $TOLE_FLEET_DIR/serve.lock;
# stop sends SIGTERM (tole serve drains up to 20 s, --shutdown-grace), waits 30 s, then SIGKILL.
#
# Exit codes: start 0 running (started or already up), 1 failed to start;
# status 0 running, 3 not running; stop 0 stopped or not running, 1 could not stop.
set -euo pipefail
umask 077  # pid, log, token and lock files are private to the owner

TOLE_BIN="${TOLE_BIN:-tole}"
DIR="${TOLE_FLEET_DIR:-$HOME/.local/state/tole-fleet}"
PORT="${TOLE_FLEET_PORT:-7801}"
BIND="${TOLE_FLEET_BIND:-127.0.0.1}"
SESSIONS="${TOLE_FLEET_SESSIONS:-$DIR/sessions}"
TOKEN_FILE="${TOLE_FLEET_TOKEN_FILE:-$DIR/token}"
PID_FILE="$DIR/serve.pid"
LOG_FILE="$DIR/serve.log"
LOCK_FILE="$DIR/serve.lock"
STOP_WAIT=30  # seconds to wait after SIGTERM before SIGKILL (serve drains up to 20 s)

log() { printf '%s tole-serve-launcher: %s\n' "$(date -u +%FT%TZ)" "$*"; }

# Live = the pid answers AND its cmdline is a `tole serve` (a recycled pid
# belonging to something else is not our daemon).
is_running() {
  local pid
  pid="$(cat "$PID_FILE" 2>/dev/null)" || return 1
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null | grep -q 'tole.* serve'
}

# Serialise start and stop: the lock fd (8) is held by this shell only; the
# daemon is started with 8>&- so it never inherits it.
lock() {
  mkdir -p "$DIR" "$SESSIONS"
  chmod 700 "$DIR"
  exec 8>"$LOCK_FILE"
  if command -v flock >/dev/null 2>&1; then
    flock -w 60 8 || { log "could not take $LOCK_FILE within 60 s"; exit 1; }
  else
    log "warning: flock not installed, start/stop are not serialised"
  fi
}

# Alive = signalable and not a zombie (a zombie has an empty cmdline).
pid_alive() { kill -0 "$1" 2>/dev/null && [[ -n "$(tr -d '\0' <"/proc/$1/cmdline" 2>/dev/null)" ]]; }

cmd="${1:-start}"
[[ $# -gt 0 ]] && shift
[[ "${1:-}" == "--" ]] && shift

case "$cmd" in
  status)
    if is_running; then log "running pid $(cat "$PID_FILE") port $PORT"; else log "not running"; exit 3; fi
    ;;
  stop)
    lock
    if is_running; then
      pid="$(cat "$PID_FILE")"
      kill "$pid" 2>/dev/null || true
      for _ in $(seq 1 $((STOP_WAIT * 10))); do pid_alive "$pid" || break; sleep 0.1; done
      if pid_alive "$pid"; then
        log "pid $pid still alive after ${STOP_WAIT}s, sending SIGKILL"
        kill -9 "$pid" 2>/dev/null || true
        for _ in $(seq 1 50); do pid_alive "$pid" || break; sleep 0.1; done
      fi
      if pid_alive "$pid"; then
        log "could not stop pid $pid; pid file kept"
        exit 1
      fi
      log "stopped pid $pid"
    else
      log "not running"
    fi
    rm -f "$PID_FILE"
    ;;
  start)
    lock
    if is_running; then log "already running pid $(cat "$PID_FILE")"; exit 0; fi
    # The token must be private even if the file pre-exists (0644, or empty).
    : >>"$TOKEN_FILE"
    chmod 600 "$TOKEN_FILE"
    if [[ ! -s "$TOKEN_FILE" ]]; then
      head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' >"$TOKEN_FILE"
      log "generated token file $TOKEN_FILE"
    fi
    # setsid detaches from the caller's session/terminal; nohup ignores SIGHUP.
    # 8>&- keeps the daemon from holding the start/stop lock.
    setsid nohup "$TOLE_BIN" serve --port "$PORT" --bind "$BIND" \
      --sessions-dir "$SESSIONS" --token-file "$TOKEN_FILE" "$@" \
      >>"$LOG_FILE" 2>&1 </dev/null 8>&- &
    pid=$!
    echo "$pid" >"$PID_FILE"
    sleep 1
    if is_running; then
      log "started pid $pid on $BIND:$PORT (log $LOG_FILE)"
    else
      # Only drop the pid file if it is still ours.
      [[ "$(cat "$PID_FILE" 2>/dev/null)" == "$pid" ]] && rm -f "$PID_FILE"
      log "failed to start; see $LOG_FILE"
      exit 1
    fi
    ;;
  *)
    echo "usage: $0 [start|stop|status] [-- extra tole serve args]" >&2
    exit 64
    ;;
esac
