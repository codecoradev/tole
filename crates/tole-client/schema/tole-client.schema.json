{
  "$defs": {
    "ActionSummary": {
      "description": "The structured summary of an approval request (#1041). `kind` and\n`effect` are the server's codes (`create_file`, `adds`, ...) and stay\nstrings: a client translates by code, and a code it does not know is\nkept, not rejected. Nothing in a summary is model text, and it never\nchanges the risk tier.",
      "properties": {
        "effect": {"type":"string"},
        "insideWorkspace": {"default":false,"description":"True only when the server confirmed the target is inside the\nworking folder.","type":"boolean"},
        "kind": {"type":"string"},
        "preview": {"default":[],"description":"Bounded raw detail: diff lines (`+` and `-`), the command, or the\ninput.","items":{"type":"string"},"type":"array"},
        "previewTruncated": {"default":false,"description":"True when `preview` is not the whole of it.","type":"boolean"},
        "target": {"description":"A path relative to the working folder, a command line, or a tool\nname.","type":"string"},
        "targetTruncated": {"default":false,"description":"True when `target` was cut.","type":"boolean"}
      },
      "required": ["kind","target","effect"],
      "type": "object"
    },
    "Approval": {
      "additionalProperties": true,
      "description": "One row of the approval queue (`GET /approvals`, the\n`approval_requested` / `approval_resolved` event frames, and a prompt\nthat stopped for approval). Rows of a delegated child have a different\nfield set: what the client does not model is kept in `extra`.",
      "properties": {
        "createdAtMs": {"format":"uint64","minimum":0,"type":["integer","null"]},
        "description": {"type":["string","null"]},
        "expiresInSeconds": {"format":"uint64","minimum":0,"type":["integer","null"]},
        "id": {"type":"string"},
        "sessionId": {"type":["string","null"]},
        "status": {"description":"`pending`, `approved`, `denied` or `expired`.","type":"string"},
        "summary": {"anyOf":[{"$ref":"#/$defs/ActionSummary"},{"type":"null"}],"description":"What the request will do, derived by code next to the gate (#1041).\nAbsent on a row from a server without it. Boxed so that the event\ntype that carries an approval stays small."},
        "tool": {"type":"string"}
      },
      "required": ["id","tool","status"],
      "type": "object"
    },
    "ApprovalList": {
      "description": "`GET /approvals`.",
      "properties": {
        "approvals": {"items":{"$ref":"#/$defs/Approval"},"type":"array"}
      },
      "required": ["approvals"],
      "type": "object"
    },
    "ArchivedSkill": {
      "description": "A skill the curator moved to the archive.",
      "properties": {
        "at": {"type":"string"},
        "entry": {"format":"uint64","minimum":0,"type":"integer"},
        "reason": {"type":"string"},
        "skill": {"type":"string"}
      },
      "required": ["skill","entry","at","reason"],
      "type": "object"
    },
    "CancelReply": {
      "description": "`POST /sessions/{id}/cancel`.",
      "properties": {
        "cancelled": {"type":"boolean"},
        "sessionId": {"type":"string"}
      },
      "required": ["cancelled","sessionId"],
      "type": "object"
    },
    "ClosedData": {
      "description": "`closed`: the session left the server.",
      "properties": {
        "id": {"type":"string"}
      },
      "required": ["id"],
      "type": "object"
    },
    "CronJob": {
      "description": "One job of `GET /cron/jobs`. `created_by` is `cli` (its owner) or\n`agent`; `awaiting_review` is true for an agent's job the owner has not\nenabled, which cannot be resumed over serve.",
      "properties": {
        "awaiting_review": {"type":"boolean"},
        "blocked": {"format":"uint64","minimum":0,"type":"integer"},
        "created_by": {"type":"string"},
        "id": {"type":"string"},
        "last": {"description":"The last run's status: `ok`, `error`, `cancelled`, `budget`,\n`awaiting_approval` or `interrupted`.","type":["string","null"]},
        "missed": {"format":"uint64","minimum":0,"type":"integer"},
        "mode": {"type":"string"},
        "name": {"type":"string"},
        "next": {"type":"string"},
        "next_run": {"description":"Unix seconds of the next run, `null` while paused.","format":"int64","type":["integer","null"]},
        "schedule": {"type":"string"},
        "state": {"description":"`active` or `paused`.","type":"string"},
        "timezone": {"type":"string"}
      },
      "required": ["id","name","schedule","timezone","mode","state","next","missed","blocked","created_by","awaiting_review"],
      "type": "object"
    },
    "CronJobState": {
      "description": "The answer to pausing or resuming a job.",
      "properties": {
        "id": {"type":"string"},
        "state": {"type":"string"}
      },
      "required": ["id","state"],
      "type": "object"
    },
    "CronJobs": {
      "description": "`GET /cron/jobs`.",
      "properties": {
        "jobs": {"items":{"$ref":"#/$defs/CronJob"},"type":"array"},
        "scheduler": {"$ref":"#/$defs/CronScheduler"}
      },
      "required": ["jobs","scheduler"],
      "type": "object"
    },
    "CronRun": {
      "description": "One run of `GET /cron/runs`; `output` is capped by the server.",
      "properties": {
        "deliveries": {"items":true,"type":"array"},
        "fire_id": {"type":"string"},
        "job_id": {"type":"string"},
        "output": {"type":"string"},
        "output_truncated": {"type":"boolean"},
        "scheduled_for": {"format":"int64","type":"integer"},
        "session_id": {"type":["string","null"]},
        "status": {"description":"`null` while the run is going.","type":["string","null"]},
        "usage": true
      },
      "required": ["fire_id","job_id","scheduled_for","deliveries","output","output_truncated"],
      "type": "object"
    },
    "CronRuns": {
      "description": "`GET /cron/runs`.",
      "properties": {
        "runs": {"items":{"$ref":"#/$defs/CronRun"},"type":"array"}
      },
      "required": ["runs"],
      "type": "object"
    },
    "CronScheduler": {
      "description": "Whether a ticker is alive to run the jobs, and where it runs.",
      "properties": {
        "age_seconds": {"format":"int64","type":["integer","null"]},
        "alive": {"type":"boolean"},
        "host": {"description":"`serve` (`tole serve --cron`) or `tick` (`tole cron tick`).","type":["string","null"]}
      },
      "required": ["alive"],
      "type": "object"
    },
    "Decision": {
      "description": "The verdict of `POST /approvals/{id}/decision`.",
      "enum": ["allow","deny"],
      "type": "string"
    },
    "DecisionReply": {
      "description": "`POST /approvals/{id}/decision`. A repeat of the same verdict is\nidempotent; the opposite verdict is a 409 ([`crate::Error::Status`]).",
      "properties": {
        "id": {"type":"string"},
        "resuming": {"description":"`true` when the allowed call is being replayed in the background.","type":["boolean","null"]},
        "status": {"type":"string"}
      },
      "required": ["id","status"],
      "type": "object"
    },
    "DecisionRequest": {
      "description": "The body of `POST /approvals/{id}/decision`. Build it with\n[`DecisionRequest::new`]: a delegated child's row (`dap-*` id) needs\n`confirm` (the id) for an allow, and its `fingerprint`.",
      "properties": {
        "confirm": {"type":["string","null"]},
        "decision": {"$ref":"#/$defs/Decision"},
        "fingerprint": {"type":["string","null"]}
      },
      "required": ["decision"],
      "type": "object"
    },
    "Discussion": {
      "description": "`GET /discussions/{id}`.",
      "properties": {
        "budget": {"format":"uint64","minimum":0,"type":"integer"},
        "criteria": {"items":{"type":"string"},"type":"array"},
        "id": {"type":"string"},
        "max_rounds": {"format":"uint32","minimum":0,"type":"integer"},
        "open_calls": {"format":"uint64","minimum":0,"type":"integer"},
        "outcome": {"anyOf":[{"$ref":"#/$defs/DiscussionOutcome"},{"type":"null"}]},
        "participants": {"items":{"type":"string"},"type":"array"},
        "question": {"type":"string"},
        "rounds": {"items":{"$ref":"#/$defs/DiscussionRound"},"type":"array"},
        "state": {"description":"`running` (a thread of this server drives it), `closed`, or\n`interrupted` (open and nobody drives it: resume it).","type":"string"},
        "status": {"type":"string"},
        "tokens_used": {"format":"uint64","minimum":0,"type":"integer"}
      },
      "required": ["id","status","question","criteria","participants","budget","max_rounds","tokens_used","open_calls","rounds","state"],
      "type": "object"
    },
    "DiscussionEstimate": {
      "description": "The answer to the estimate: the cost plan as text and as numbers.",
      "properties": {
        "advice": {"items":{"type":"string"},"type":"array"},
        "budget_tokens": {"format":"uint64","minimum":0,"type":"integer"},
        "files": {"items":{"type":"string"},"type":"array"},
        "max_calls": {"format":"uint64","minimum":0,"type":"integer"},
        "max_rounds": {"format":"uint32","minimum":0,"type":"integer"},
        "participants": {"items":{"type":"string"},"type":"array"},
        "plan": {"type":"string"},
        "round_floor_tokens": {"format":"uint64","minimum":0,"type":"integer"}
      },
      "required": ["plan","advice","participants","max_rounds","max_calls","budget_tokens","round_floor_tokens","files"],
      "type": "object"
    },
    "DiscussionList": {
      "description": "`GET /discussions`.",
      "properties": {
        "discussions": {"items":{"$ref":"#/$defs/DiscussionRow"},"type":"array"}
      },
      "required": ["discussions"],
      "type": "object"
    },
    "DiscussionOutcome": {
      "description": "How a closed discussion ended: the gate's decision and the report text.",
      "properties": {
        "gate": {"type":"string"},
        "text": {"type":"string"},
        "why": {"type":"string"}
      },
      "required": ["gate","why","text"],
      "type": "object"
    },
    "DiscussionRequest": {
      "description": "The body of `POST /discussions/estimate`: what the owner types for\n`tole discuss start`. Participants are profile names of the server\nowner's user config; `files` are paths inside the server's workspace.",
      "properties": {
        "budget_tokens": {"format":"uint64","minimum":0,"type":"integer"},
        "criteria": {"items":{"type":"string"},"type":"array"},
        "files": {"items":{"type":"string"},"type":"array"},
        "id": {"type":["string","null"]},
        "max_rounds": {"format":"uint32","minimum":0,"type":["integer","null"]},
        "participants": {"items":{"type":"string"},"type":"array"},
        "question": {"type":"string"}
      },
      "required": ["question","criteria","participants","budget_tokens"],
      "type": "object"
    },
    "DiscussionResumed": {
      "description": "The answer to `POST /discussions/{id}/resume`.",
      "properties": {
        "id": {"type":"string"},
        "status": {"type":"string"}
      },
      "required": ["id","status"],
      "type": "object"
    },
    "DiscussionRound": {
      "description": "One round of a discussion. `summary` is the scribe's digest (decisions,\nclaims, `disagreements`, open questions, actions) or the list of\nspeakers when it was passed on as written; `checklist` is the\nclaim-checker's verdict per criterion. Both stay as the server's JSON.",
      "properties": {
        "charged": {"items":true,"type":"array"},
        "checklist": {"items":true,"type":["array","null"]},
        "gate": {"type":["string","null"]},
        "retries": {"format":"uint64","minimum":0,"type":"integer"},
        "round": {"format":"uint32","minimum":0,"type":"integer"},
        "speakers": {"items":{"type":"string"},"type":"array"},
        "summary": true,
        "tokens": {"format":"uint64","minimum":0,"type":"integer"}
      },
      "required": ["round","speakers","tokens","retries","charged"],
      "type": "object"
    },
    "DiscussionRow": {
      "description": "One row of `GET /discussions`. A ledger that cannot be read is a row\nwith `status` `unreadable` and an `error` instead of the figures.",
      "properties": {
        "budget": {"format":"uint64","minimum":0,"type":["integer","null"]},
        "error": {"type":["string","null"]},
        "id": {"type":"string"},
        "question": {"type":["string","null"]},
        "rounds": {"format":"uint64","minimum":0,"type":["integer","null"]},
        "status": {"description":"`open`, `closed (<gate>)` or `unreadable`.","type":"string"},
        "tokens_used": {"format":"uint64","minimum":0,"type":["integer","null"]}
      },
      "required": ["id","status"],
      "type": "object"
    },
    "DiscussionStarted": {
      "description": "The answer to `POST /discussions`: the contract is recorded and the\ndiscussion runs.",
      "properties": {
        "advice": {"items":{"type":"string"},"type":"array"},
        "id": {"type":"string"},
        "plan": {"type":"string"},
        "status": {"type":"string"}
      },
      "required": ["id","status","plan","advice"],
      "type": "object"
    },
    "DiscussionStopped": {
      "description": "The answer to `POST /discussions/{id}/stop`. `state` is `closed` once\nthe report is written, `running` while its thread is still closing it.",
      "properties": {
        "id": {"type":"string"},
        "note": {"type":["string","null"]},
        "outcome": {"type":"string"},
        "state": {"type":"string"}
      },
      "required": ["id","outcome","state"],
      "type": "object"
    },
    "EntriesPage": {
      "description": "`GET /sessions/{id}/entries`. Page with `after = next_after` while\n`has_more`.",
      "properties": {
        "entries": {"items":{"$ref":"#/$defs/Entry"},"type":"array"},
        "hasMore": {"type":"boolean"},
        "id": {"type":"string"},
        "lastSeq": {"format":"uint64","minimum":0,"type":"integer"},
        "nextAfter": {"format":"uint64","minimum":0,"type":"integer"}
      },
      "required": ["id","entries","nextAfter","hasMore","lastSeq"],
      "type": "object"
    },
    "Entry": {
      "additionalProperties": false,
      "description": "`tole_core::entry::Entry`, mirrored because tole-core must not depend on\n`schemars`. `the_entry_mirror_matches_tole_core` keeps the two in step: the\nmirror refuses unknown keys, and both must carry the same key set.",
      "properties": {
        "id": {"description":"Unique entry id (`e_<seq>` when auto-assigned).","type":"string"},
        "parentId": {"default":null,"description":"Parent entry id; null only for the session root entry.","type":["string","null"]},
        "payload": {"description":"Type-specific payload, owned by the entry kind."},
        "seq": {"description":"Global monotonic sequence number assigned at commit time.","format":"uint64","minimum":0,"type":"integer"},
        "timestamp": {"description":"Creation time, milliseconds since the Unix epoch.","format":"uint64","minimum":0,"type":"integer"},
        "type": {"description":"What kind of entry this is. A string, not a closed set: a newer server\nmay write kinds this client does not know (`message`, `intent`,\n`tool_result` and `error` today).","type":"string"}
      },
      "required": ["seq","id","type","timestamp","payload"],
      "type": "object"
    },
    "Health": {
      "description": "`GET /health`: `status`, and since serve reports its protocol and\nbinary version (#1043) also `protocol` and `version`. Both are\noptional so a server that predates them still decodes, and a decoded\nanswer serializes back to the JSON the server sent.",
      "properties": {
        "protocol": {"format":"uint32","minimum":0,"type":["integer","null"]},
        "status": {"type":"string"},
        "version": {"type":["string","null"]}
      },
      "required": ["status"],
      "type": "object"
    },
    "Models": {
      "description": "`GET /models`: what the owner lets a client pick.",
      "properties": {
        "default": {"type":["string","null"]},
        "models": {"items":{"type":"string"},"type":"array"}
      },
      "required": ["models"],
      "type": "object"
    },
    "NewSession": {
      "description": "`POST /sessions`: create a session, or reopen one with `resume`.",
      "properties": {
        "cwd": {"description":"Working folder (must lie inside the server's workspace).","type":["string","null"]},
        "plan_mode": {"description":"Only when creating: the registry without mutation tools.","type":["boolean","null"]},
        "profile": {"type":["string","null"]},
        "resume": {"description":"Reopen this session id instead of creating one.","type":["string","null"]}
      },
      "type": "object"
    },
    "PastSession": {
      "description": "One row of `GET /sessions/index`: a past or live session of the workspace.",
      "properties": {
        "busy": {"type":"boolean"},
        "entries": {"format":"uint64","minimum":0,"type":"integer"},
        "folder": {"type":"string"},
        "id": {"type":"string"},
        "lastActivity": {"description":"Milliseconds since the Unix epoch.","format":"uint64","minimum":0,"type":"integer"},
        "live": {"type":"boolean"},
        "name": {"type":["string","null"]},
        "parent": {"description":"The session this one was forked from.","type":["string","null"]},
        "turns": {"format":"uint64","minimum":0,"type":"integer"}
      },
      "required": ["id","folder","lastActivity","entries","turns","live","busy"],
      "type": "object"
    },
    "Profile": {
      "description": "One helper of `GET /profiles`. A profile that cannot be loaded is a row\nwith only `name` and `error`. `persona` is the first line of the persona\nfile (absent when it has none); `models` has the tiers the profile sets\nand its `default` tier name; `may_use` is the profile's own allow list\nand `session_allow` what a session opened with it gets on this server.",
      "properties": {
        "error": {"type":["string","null"]},
        "may_use": {"items":{"type":"string"},"type":["array","null"]},
        "memory_room": {"type":["string","null"]},
        "models": {"additionalProperties":true,"type":["object","null"]},
        "name": {"type":"string"},
        "persona": {"type":["string","null"]},
        "persona_chars": {"format":"uint64","minimum":0,"type":["integer","null"]},
        "session_allow": {"items":{"type":"string"},"type":["array","null"]}
      },
      "required": ["name"],
      "type": "object"
    },
    "Profiles": {
      "description": "`GET /profiles`.",
      "properties": {
        "profiles": {"items":{"$ref":"#/$defs/Profile"},"type":"array"}
      },
      "required": ["profiles"],
      "type": "object"
    },
    "PromptReply": {
      "description": "The answer to a prompt, once the turn stopped. `stop_reason` is\n`approval_required` when a Write waits for a decision: `approval` is\nthen the queue row (absent when it was decided or expired meanwhile).",
      "properties": {
        "approval": {"anyOf":[{"$ref":"#/$defs/Approval"},{"type":"null"}]},
        "stopReason": {"type":"string"},
        "text": {"type":["string","null"]}
      },
      "required": ["stopReason"],
      "type": "object"
    },
    "PromptRequest": {
      "description": "`POST /sessions/{id}/prompt`.",
      "properties": {
        "images": {"description":"Ids of images uploaded to this session.","items":{"type":"string"},"type":"array"},
        "text": {"type":"string"}
      },
      "required": ["text"],
      "type": "object"
    },
    "Ready": {
      "description": "`ready`: the replay is complete.",
      "properties": {
        "after": {"format":"uint64","minimum":0,"type":"integer"},
        "busy": {"type":"boolean"},
        "id": {"type":"string"},
        "lastSeq": {"format":"uint64","minimum":0,"type":"integer"}
      },
      "required": ["id","after","lastSeq","busy"],
      "type": "object"
    },
    "ResyncData": {
      "description": "`resync`: ephemeral frames this slow stream lost.",
      "properties": {
        "dropped": {"format":"uint64","minimum":0,"type":"integer"}
      },
      "required": ["dropped"],
      "type": "object"
    },
    "SessionIndex": {
      "description": "`GET /sessions/index`. Page with `cursor = next_cursor`.",
      "properties": {
        "nextCursor": {"type":["string","null"]},
        "scanTruncated": {"type":"boolean"},
        "sessions": {"items":{"$ref":"#/$defs/PastSession"},"type":"array"},
        "skipped": {"format":"uint64","minimum":0,"type":"integer"}
      },
      "required": ["sessions","skipped","scanTruncated"],
      "type": "object"
    },
    "SessionList": {
      "description": "`GET /sessions`: the sessions live in this serve.",
      "properties": {
        "sessions": {"items":{"$ref":"#/$defs/SessionSummary"},"type":"array"}
      },
      "required": ["sessions"],
      "type": "object"
    },
    "SessionOpened": {
      "description": "The answer to `POST /sessions`. A create sets `workspace`; a resume\nsets `resumed` and `already_live` (and `busy` for a session that was\nalready live).",
      "properties": {
        "alreadyLive": {"type":["boolean","null"]},
        "busy": {"type":["boolean","null"]},
        "planMode": {"type":["boolean","null"]},
        "profile": {"type":["string","null"]},
        "resumed": {"type":["boolean","null"]},
        "sessionId": {"type":"string"},
        "workspace": {"type":["string","null"]}
      },
      "required": ["sessionId"],
      "type": "object"
    },
    "SessionStatus": {
      "description": "`GET /sessions/{id}/status`. Model, effort and context figures are\n`null` until known; `stale` says they come from the last snapshot\nbecause a turn is running.",
      "properties": {
        "busy": {"type":"boolean"},
        "contextUsed": {"format":"uint64","minimum":0,"type":["integer","null"]},
        "contextWindow": {"format":"uint64","minimum":0,"type":["integer","null"]},
        "effort": {"type":["string","null"]},
        "entries": {"description":"`null` while a turn holds the session.","format":"uint64","minimum":0,"type":["integer","null"]},
        "id": {"type":"string"},
        "model": {"type":["string","null"]},
        "name": {"type":["string","null"]},
        "snapshotAt": {"format":"uint64","minimum":0,"type":["integer","null"]},
        "stale": {"type":"boolean"},
        "usage_report": {"description":"The usage report as the server builds it (opaque to the client)."}
      },
      "required": ["id","busy","usage_report","stale"],
      "type": "object"
    },
    "SessionSummary": {
      "description": "One live session in `GET /sessions`.",
      "properties": {
        "busy": {"type":"boolean"},
        "id": {"type":"string"},
        "profile": {"type":["string","null"]}
      },
      "required": ["id","busy"],
      "type": "object"
    },
    "SkillDraft": {
      "description": "A skill the agent proposed, waiting for the owner's review.",
      "properties": {
        "created_at": {"type":"string"},
        "description": {"type":"string"},
        "hash": {"type":"string"},
        "id": {"type":"string"},
        "name": {"type":"string"},
        "nearest": {"type":["string","null"]},
        "tainted": {"description":"The session that proposed it read untrusted text.","type":"boolean"},
        "warnings": {"items":{"type":"string"},"type":"array"}
      },
      "required": ["id","name","description","created_at","hash","tainted","warnings"],
      "type": "object"
    },
    "SkillRow": {
      "description": "One skill of `GET /skills`. `state` is `approved`, `changed` (the\ncontent differs from what was approved: it is not used), `not_approved`,\n`refused` (the approval ledger disagrees) or `unreadable`.",
      "properties": {
        "approved_at": {"type":["string","null"]},
        "approved_hash": {"type":["string","null"]},
        "hash": {"type":["string","null"]},
        "history": {"items":true,"type":"array"},
        "name": {"type":"string"},
        "source": true,
        "source_text": {"type":"string"},
        "state": {"type":"string"},
        "status": {"type":"string"}
      },
      "required": ["name","state","status","source_text","history"],
      "type": "object"
    },
    "SkillsState": {
      "description": "`GET /skills`.",
      "properties": {
        "archived": {"items":{"$ref":"#/$defs/ArchivedSkill"},"type":"array"},
        "drafts": {"items":{"$ref":"#/$defs/SkillDraft"},"type":"array"},
        "notes": {"items":{"type":"string"},"type":"array"},
        "skills": {"items":{"$ref":"#/$defs/SkillRow"},"type":"array"}
      },
      "required": ["skills","drafts","archived","notes"],
      "type": "object"
    },
    "TextData": {
      "description": "`text_delta` and `reasoning`.",
      "properties": {
        "text": {"type":"string"}
      },
      "required": ["text"],
      "type": "object"
    },
    "ToolFinishedData": {
      "description": "`tool_finished`.",
      "properties": {
        "ok": {"type":"boolean"},
        "preview": {"type":"string"},
        "tool": {"type":"string"}
      },
      "required": ["tool","ok","preview"],
      "type": "object"
    },
    "ToolServer": {
      "description": "One connected tool server of `GET /tools`. `trust` is `trusted`,\n`changed`, `not_trusted` or `removed` (revoked, or approved but no\nlonger configured); `state` is the sentence `tole plugin list` prints.",
      "properties": {
        "approved_at": {"type":["string","null"]},
        "lock": {"type":"string"},
        "manifest_hash": {"type":["string","null"]},
        "name": {"type":"string"},
        "sandbox": {"type":"string"},
        "secrets": {"items":{"type":"string"},"type":"array"},
        "source": {"type":["string","null"]},
        "state": {"type":"string"},
        "tier": {"type":"string"},
        "trust": {"type":"string"},
        "version": {"type":["string","null"]}
      },
      "required": ["trust","name","state","tier","secrets","sandbox","lock"],
      "type": "object"
    },
    "ToolStartedData": {
      "description": "`tool_started`.",
